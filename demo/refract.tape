Output demo/refract.gif
Set Theme "Catppuccin Mocha"
Set FontSize 20
Set Width 980
Set Height 500
Set TypingSpeed 42ms
Set Shell bash
Set CursorBlink false
Set Padding 16

Hide
Type `export PS1="$ "`
Enter
Type `clear`
Enter
Show
Sleep 600ms

Type "refract init frontend"
Enter
Sleep 7s

Type "refract init backend --color black/red"
Enter
Sleep 7s

Type "refract list"
Enter
Sleep 7s

Type "refract use frontend"
Enter
Sleep 8s

Type "pip install django"
Enter
Sleep 12s

Type "exit"
Enter
Sleep 6s

Type "refract use backend"
Enter
Sleep 7s

Type "pip show django"
Enter
Sleep 7s

Type "exit"
Enter 
Sleep 7s

Type "refract rm backend"
Enter
Sleep 7s

Type "refract list"
Enter
Sleep 7s
